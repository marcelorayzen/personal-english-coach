{
  "name": "personal-english-coach",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke:wave1": "node scripts/smoke-wave1.mjs",
    "smoke:phase4": "node scripts/smoke-phase4.mjs",
    "smoke:phase5": "node scripts/smoke-phase5.mjs",
    "db:generate": "pnpm --filter @personal-english-coach/api prisma:generate",
    "db:migrate": "pnpm --filter @personal-english-coach/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @personal-english-coach/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @personal-english-coach/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@prisma/client": "^6.19.3",
    "eslint": "^9.24.0",
    "prisma": "^6.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
